{
  "name": "todd-goldman",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "description": "Todd Goldman portfolio — standalone Next.js app",
  "scripts": {
    "dev": "next dev -p 3010",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:contract": "tsx scripts/test-content-contract.ts",
    "test:visual": "playwright test scripts/visual-regression-home.spec.ts --reporter=line",
    "test:animations": "playwright test scripts/audit-animations.spec.ts --reporter=line",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test:contract && pnpm run build",
    "check:release": "pnpm run check && pnpm run test:visual && pnpm run test:animations",
    "preview:out": "serve out -l 3460"
  },
  "dependencies": {
    "lenis": "1.1.9",
    "motion": "^12.42.2",
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-plugin-boundaries": "^7.1.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "serve": "^14.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5",
    "@playwright/test": "^1.55.0"
  }
}
